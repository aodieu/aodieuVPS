# aodieuVPS Rocky Linux 10 / MariaDB 10.11
# Retains the original memory-tier tuning; removes obsolete MariaDB 5.5/10.0 options.
[client]
socket=/var/lib/mysql/mysql.sock

[mysqld]
local_infile=0
character-set-server=utf8
datadir=/var/lib/mysql
socket=/var/lib/mysql/mysql.sock
max_connections = 1000
key_buffer_size = 768M
table_open_cache = 8192
tmp_table_size = 1024M
max_heap_table_size = 1024M
query_cache_size = 256M
innodb_buffer_pool_size = 8192M
innodb_log_file_size = 768M
innodb_log_buffer_size = 16M
max_allowed_packet = 128M
join_buffer_size = 2M
sort_buffer_size = 2M
read_buffer_size = 2M
slow_query_log = 0
long_query_time = 1
innodb_flush_log_at_trx_commit = 2
innodb_file_per_table = 1
innodb_io_capacity = 600
innodb_io_capacity_max = 2000
innodb_lock_wait_timeout = 50
slow_query_log_file=/home/server_name_here/logs/mysql-slow.log
log_error=/home/server_name_here/logs/mysql.log

[mysqldump]
quick
max_allowed_packet=64M
